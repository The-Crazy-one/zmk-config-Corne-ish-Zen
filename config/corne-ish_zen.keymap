#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define QWERTY 0
#define NUMBER 1
#define SYMBOL 2

/ {
    behaviors {
        // Kein Sticky, alles normal!
    };

    chosen { zmk,matrix_transform = &default_transform; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWERTY";
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R  &kp T      &kp Y      &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp LCTRL  &kp A  &kp S  &kp D     &kp F  &kp G      &kp H      &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C     &kp V  &kp B      &kp N      &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                         &kp LGUI  &mo 1  &kp RET    &kp SPACE  &mo 2  &kp RALT
            >;
        };

        lower_layer {
            label = "NUMBER";
            bindings = <
&kp TAB     &mt F1 N1     &mt F2 N2     &mt F3 N3     &mt F4 N4     &mt F5 N5       &mt F6 N6  &mt F7 N7  &mt F8 N8  &mt F9 N9  &mt F10 N0  &kp BSPC
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &kp F11     &kp F12
&kp LSHFT   &kp C_PREV    &kp C_NEXT    &kp C_PP      &kp C_VOL_DN  &kp C_VOL_UP    &trans     &trans     &trans     &trans     &trans      &trans
                                        &kp LGUI      &trans        &kp F12         &kp RET    &trans     &kp RALT
            >;
        };

        raise_layer {
            label = "SYMBOL";
            bindings = <
&kp TAB    &kp EXCL    &kp AT      &kp HASH  &kp DLLR      &kp PRCNT       &kp CARET  &kp AMPS   &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &kp BSPC
&kp LCTRL  &kp LEFT    &kp DOWN    &kp UP    &kp RIGHT     &kp SPACE       &kp MINUS  &kp EQUAL  &kp LBKT         &kp RBKT  &kp BSLH  &kp GRAVE
&kp LSHFT  &kp C_PREV  &kp C_NEXT  &kp C_PP  &kp K_VOL_DN  &kp C_VOL_UP    &kp UNDER  &kp PLUS   &kp LBRC         &kp RBRC  &kp PIPE  &kp TILDE
                                   &kp LGUI  &trans        &kp RET         &kp SPACE  &trans     &kp RALT
            >;
        };
    };
};
