#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        // Kein Sticky, alles normal!
    };

    chosen { zmk,matrix_transform = &default_transform; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWERTY";
            bindings = <
&kp TAB          &mt LC(Q) Q  &mt LC(W) W  &mt LC(E) E  &mt LC(R) R  &mt LC(T) T    &mt LC(Y) Y  &mt LC(U) U  &mt LC(I) I  &mt LC(O) O  &mt LC(P) P  &kp BSPC
&kp LCTRL        &mt LC(A) A  &mt LC(S) S  &mt LC(D) D  &mt LC(F) F  &mt LC(G) G    &mt LC(H) H  &mt LC(J) J  &mt LC(K) K  &mt LC(L) L  &kp SEMI     &kp SQT
&mt CLCK LSHIFT  &mt LC(Z) Z  &mt LC(X) X  &mt LC(C) C  &mt LC(V) V  &mt LC(B) B    &mt LC(N) N  &mt LC(M) M  &kp COMMA    &kp DOT      &kp FSLH     &kp ESC
                                           &kp LGUI     &mo 1        &kp RET        &kp SPACE    &mo 2        &kp RALT
            >;
        };

        lower_layer {
            label = "NUMBER";
            bindings = <
&kp TAB     &kp N1        &kp N2        &kp N3        &kp N4        &kp N5          &kp N6     &kp N7    &kp N8    &kp N9     &kp N0  &kp BSPC
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp LEFT   &kp DOWN  &kp UP    &kp RIGHT  &trans  &trans
&kp LSHFT   &tog 3        &trans        &trans        &kp C_VOL_DN  &kp C_VOL_UP    &trans     &trans    &trans    &trans     &trans  &trans
                                        &kp F12       &trans        &sl 1           &kp SPACE  &trans    &kp RALT
            >;
        };

        raise_layer {
            label = "SYMBOL";
            bindings = <
&kp TAB    &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS   &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &kp BSPC
&kp LCTRL  &trans    &trans  &trans    &trans    &trans       &kp MINUS  &kp EQUAL  &kp LBKT         &kp RBKT  &kp BSLH  &kp GRAVE
&kp LSHFT  &trans    &trans  &trans    &trans    &trans       &kp UNDER  &kp PLUS   &kp LBRC         &kp RBRC  &kp PIPE  &kp TILDE
                             &kp LGUI  &trans    &kp RET      &kp SPACE  &trans     &kp RALT
            >;
        };

        navi {
           label = "NAVI";
            bindings = <
&kp C_PREV  &kp C_NEXT      &kp C_PP        &kp C_MUTE    &kp C_VOL_DN     &kp C_VOL_UP      &trans  &trans  &trans  &trans  &trans  &trans
&mkp MB2    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &mkp MB1          &trans  &trans  &trans  &trans  &trans  &trans
&trans      &mkp MB4        &mkp MB5        &mkp MB3      &msc SCRL_UP     &msc SCRL_DOWN    &trans  &trans  &trans  &trans  &trans  &trans
                                            &trans        &trans           &trans            &trans  &trans  &trans
            >;
        };
    };
};
